{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposals"],
  "properties": {
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mechanism", "hypothesis", "evidence_refs", "structural_change", "expected_benefit", "regression_risk", "benchmark_test"],
        "properties": {
          "mechanism": {"enum": ["invariant", "topology", "roles", "tools", "search-policy", "resource-allocation"]},
          "hypothesis": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "structural_change": {"type": "string", "minLength": 1},
          "expected_benefit": {"type": "string", "minLength": 1},
          "regression_risk": {"type": "string", "minLength": 1},
          "benchmark_test": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
