{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["assessment", "mutation"],
  "properties": {
    "assessment": {"type": "string", "minLength": 1},
    "mutation": {
      "anyOf": [
        {"type": "null"},
        {
        "type": "object",
        "additionalProperties": false,
        "required": ["changed_file", "hypothesis", "evidence_refs", "expected_benefit", "regression_risk", "benchmark_test"],
        "properties": {
          "changed_file": {"type": "string", "minLength": 1},
          "hypothesis": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "expected_benefit": {"type": "string", "minLength": 1},
          "regression_risk": {"type": "string", "minLength": 1},
          "benchmark_test": {"type": "string", "minLength": 1}
        }
        }
      ]
    }
  }
}
