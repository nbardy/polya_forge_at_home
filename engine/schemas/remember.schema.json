{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["changes"],
  "properties": {
    "changes": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "packet_ids", "future_use"],
        "properties": {
          "kind": {"enum": ["advance-frontier", "remove-assumption", "retire-route", "preserve-salvage"]},
          "packet_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "future_use": {"type": "string", "pattern": ".+"}
        }
      }
    }
  }
}
