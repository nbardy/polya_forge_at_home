{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "endpoint_disposition", "claim_status", "audit", "evidence", "first_open_or_invalid_line", "failure"],
  "properties": {
    "verdict": {"enum": ["PASS", "REPAIR", "FAIL", "QUARANTINE"]},
    "endpoint_disposition": {"enum": ["OPEN", "CANDIDATE"]},
    "claim_status": {"enum": ["question", "heuristic", "conjecture", "proved-lemma", "known-theorem", "computational-evidence", "refuted", "unresolved"]},
    "audit": {"type": "string", "pattern": ".+"},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "first_open_or_invalid_line": {"type": "string", "pattern": ".+"},
    "failure": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope", "surviving_core", "smallest_repair", "reopening_test"],
          "properties": {
            "scope": {"type": "string", "pattern": ".+"},
            "surviving_core": {"type": "string"},
            "smallest_repair": {"type": "string", "pattern": ".+"},
            "reopening_test": {"type": "string", "pattern": ".+"}
          }
        }
      ]
    }
  }
}
