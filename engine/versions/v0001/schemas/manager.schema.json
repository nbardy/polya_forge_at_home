{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["manager_review", "endpoint", "first_open_line", "briefs"],
  "properties": {
    "manager_review": {"type": "string"},
    "endpoint": {"type": "string"},
    "first_open_line": {"type": "string"},
    "briefs": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "objective", "endpoint_edge", "first_open_line", "inputs", "exclusions", "cheapest_falsifier", "completion_criteria", "kill_criteria", "claim_state", "needs_verification"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,31}$"},
          "objective": {"type": "string"},
          "endpoint_edge": {"type": "string"},
          "first_open_line": {"type": "string"},
          "inputs": {"type": "array", "items": {"type": "string"}},
          "exclusions": {"type": "array", "items": {"type": "string"}},
          "cheapest_falsifier": {"type": "string"},
          "completion_criteria": {"type": "string"},
          "kill_criteria": {"type": "string"},
          "claim_state": {"type": "string"},
          "needs_verification": {"type": "boolean"}
        }
      }
    }
  }
}

