{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["mathematical_progress", "polya_receipt", "continue_research", "next_open_line", "next_strategy"],
  "properties": {
    "mathematical_progress": {"type": "string"},
    "polya_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["advanced_first_open_line", "removed_hypothesis", "killed_route_class", "side_theorem", "reusable_research_asset", "supporting_brief_ids", "explanation"],
      "properties": {
        "advanced_first_open_line": {"type": "boolean"},
        "removed_hypothesis": {"type": "boolean"},
        "killed_route_class": {"type": "boolean"},
        "side_theorem": {"type": "boolean"},
        "reusable_research_asset": {"type": "boolean"},
        "supporting_brief_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "explanation": {"type": "string"}
      }
    },
    "continue_research": {"type": "boolean"},
    "next_open_line": {"type": "string"},
    "next_strategy": {"type": "string"}
  }
}
