{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polya-forge-at-home.invalid/schemas/contribution.schema.json",
  "title": "Pólya Forge contribution bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "kind", "run_id", "problem_id", "engine_hash", "content_hash"],
  "properties": {
    "format_version": {"const": 2},
    "kind": {"enum": ["research", "harness"]},
    "run_id": {"type": "string"},
    "problem_id": {"type": "string"},
    "engine_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
