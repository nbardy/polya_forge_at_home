{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polya-forge-at-home.invalid/schemas/problem.schema.json",
  "title": "Pólya Forge problem pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["format-version", "id", "title", "status", "official-source", "admission"],
  "properties": {
    "format-version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 1},
    "status": {"enum": ["open", "solved", "benchmark", "inactive"]},
    "official-source": {"type": "string", "format": "uri"},
    "admission": {"type": "object"}
  }
}
