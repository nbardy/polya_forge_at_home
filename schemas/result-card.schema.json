{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pólya Forge result card",
  "type": "object",
  "additionalProperties": false,
  "required": ["claim_id", "statement", "claim_status", "independent_research_value", "prize_leverage", "evidence", "verification_required"],
  "properties": {
    "claim_id": {"type": "string"},
    "statement": {"type": "string"},
    "claim_status": {"type": "string"},
    "independent_research_value": {"enum": ["none", "benchmark", "lemma", "theorem"]},
    "prize_leverage": {"enum": ["none", "conditional-interface", "hypothesis-removed", "endpoint-edge-closed"]},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "verification_required": {"type": "array", "items": {"type": "string"}}
  }
}

